<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:_1125_Sveta.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:DataType="viewModels:MessageBoxViewModel"
        x:Class="_1125_Sveta.Views.MessageBoxWindow"
        Title="MessageBoxWindow" Height="250" Width="450" WindowStartupLocation="CenterScreen">
        <Grid RowDefinitions="Auto *">
            <StackPanel Grid.Row="0">
                <TextBlock  HorizontalAlignment="Center" FontSize="30" Text="{Binding Message}"
                           Margin="10"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Row="1" FontSize="28" VerticalAlignment="Center" Content="OK" HorizontalAlignment="Center"
                    Command="{Binding CloseCommand}"/>
        </Grid>
</Window>
