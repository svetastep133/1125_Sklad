<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:_1125_Sveta.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="_1125_Sveta.Views.NewProductWindow"
        x:DataType="viewModels:NewProductViewModel"
        Title="NewProductWindow">
        <Grid>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"></ComboBox>
                <TextBox></TextBox>
                <Button Command="{Binding SaveProductCommand}"></Button>
                
                
        </Grid>
</Window>
