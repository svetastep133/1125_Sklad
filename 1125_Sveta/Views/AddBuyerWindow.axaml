<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:_1125_Sveta.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="_1125_Sveta.Views.AddBuyerWindow"
        x:DataType="viewModels:AddBuyerViewModel"
        Title="AddBuyer" Height="250" Width="500" WindowStartupLocation="CenterScreen" Background="#F5F7FA">
        
        <Grid RowDefinitions="Auto Auto Auto Auto" VerticalAlignment="Center" HorizontalAlignment="Center" RowSpacing="10">
                <StackPanel>
                <TextBlock  FontSize="17" FontWeight="Bold"  Text="Введите имя покупателя"/>
                <TextBox Background="White" Height="40" Width="360" Text="{Binding BuyerName}"/>
                <TextBlock FontSize="17" FontWeight="Bold"  Text="Введите Электронную почту покупателя"/>
                <TextBox Background="White" Height="40" Width="360" Text="{Binding BuyerEmail}"/>
                <Button Margin="0,10,0,0" FontWeight="Bold" Foreground="White" Background="#2563EB" FontSize="22" Height="40" Width="125" HorizontalAlignment="Center" VerticalAlignment="Bottom" Command="{Binding AddBuyerCommand}" Content="Добавить"/>
                </StackPanel>
        </Grid>
  
</Window>
