<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:_1125_Sveta.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="_1125_Sveta.Views.AddBuyerWindow"
        x:DataType="viewModels:AddBuyerViewModel"
        Title="AddBuyer" Height="200" Width="500" WindowStartupLocation="CenterScreen">
        
        <Grid RowDefinitions="Auto Auto Auto" HorizontalAlignment="Center" RowSpacing="10">
                <Label Grid.Row="0"  HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" Content="Укажите имя нового покупателя"/>
                <TextBox Grid.Row="1" Text="{Binding BuyerName}"/>
                <Button Grid.Row="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Command="{Binding AddBuyerCommand}" Content="Добавить"/>
        </Grid>
  
</Window>
