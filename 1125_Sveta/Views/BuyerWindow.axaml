<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        WindowState="Maximized"
        xmlns:viewModels="clr-namespace:_1125_Sveta.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:DataType="viewModels:BuyerViewModel"
        x:Class="_1125_Sveta.Views.BuyerWindow"
        Title="BuyerWindow" Background="#F5F7FA">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        
        <Border Grid.Row="0"
                Background="#2563EB"
                Padding="20">

            <Grid ColumnDefinitions="Auto,*">

                <Button Grid.Column="0"
                        Width="105"
                        Height="40"
                        Background="#E5E7EB"
                        FontWeight="Bold"
                        FontSize="20"
                        Content="← Назад"
                        Command="{Binding BackCommand}"/>

                <TextBlock Grid.Column="1"
                           Text="Покупатели"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>
        <Border Grid.Row="1"
                Margin="20"
                Padding="15"
                Background="White"
                CornerRadius="12">

            <TextBox Watermark="Поиск покупателя..."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        </Border>

        <ListBox Grid.Row="2"
                 Margin="20,0"
                 ItemsSource="{Binding Buyers}"
                 SelectedItem="{Binding SelectedBuyers}">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <Border Margin="0,0,0,12"
                            Padding="18"
                            Background="White"
                            CornerRadius="12">

                        <Grid RowDefinitions="Auto,Auto">

                            <TextBlock FontSize="20"
                                       FontWeight="Bold"
                                       Text="{Binding Name}"/>

                            <TextBlock Grid.Row="1"
                                       Margin="0,8,0,0"
                                       FontSize="16"
                                       Foreground="#6B7280"
                                       Text="{Binding Email}"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>

        <Border Grid.Row="3"
                Background="White"
                Padding="20">

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="15">

                <Button Grid.Column="0"
                        Height="45"
                        Margin="190,0,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="White" Background="#2563EB"
                        Content="Добавить покупателя"
                        Command="{Binding AddBuyerCommand}"/>

                <Button Grid.Column="1"
                        Height="45"
                        FontSize="22"
                        Foreground="White" Background="#2563EB"
                        Margin="110,0,0,0"
                        FontWeight="Bold"
                        Content="Редактировать"
                        Command="{Binding EditCommand}"/>

                <Button Grid.Column="2"
                        Height="45"
                        Foreground="White" Background="#2563EB"
                        FontSize="22"
                        Margin="0,0,50,0"
                        FontWeight="Bold"
                        Content="Удалить"
                        Command="{Binding DeleteCommand}"/>

            </Grid>

        </Border>

    </Grid>

</Window>
