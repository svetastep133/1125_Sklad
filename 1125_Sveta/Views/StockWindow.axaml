<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:_1125_Sveta.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="_1125_Sveta.Views.StockWindow"
        x:DataType="viewModels:StockViewModel"
        Title="StockWindow">
  <Grid RowDefinitions="Auto Auto Auto *" >
      <Label HorizontalAlignment="Center" FontWeight="Bold" FontSize="28" Content="{Binding SelectedWarehouse.Name}"/>
      <Label  Grid.Row="1" HorizontalAlignment="Center"  FontSize="22" Content="{Binding SelectedWarehouse.Location}"/>
      <ListBox Grid.Row="2" ItemsSource="{Binding Stocks}" >
        <ListBox.ItemTemplate>
            <DataTemplate>
                <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding ProductsName}" />
                <TextBlock FontSize="18" Text="{Binding Quantity, StringFormat={}Общее количество: {0}}"/>
                <TextBlock FontSize="18" Text="{Binding Reserved, StringFormat={}Зарезервировано: {0}}"/>
                <TextBlock FontSize="18" Text="{Binding LastUpdated, StringFormat={}Последнее обновление: {0}}"/>
               </StackPanel>
            </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox> 
      <Button  Grid.Row="3" FontSize="20" Width="110" Height="42" VerticalAlignment="Bottom" Command="{Binding AddProductCommand}" Content="Добавить"/> 
  </Grid>
</Window>
